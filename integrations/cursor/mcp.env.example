# Example `envFile` referenced by .cursor/mcp.json.
#
# Copy it outside the repo, e.g.:
#   mkdir -p ~/.config/todolist && chmod 700 ~/.config/todolist
#   cp mcp.env.example ~/.config/todolist/mcp.env && chmod 600 ~/.config/todolist/mcp.env
#
# Create the token in the ToDoList web UI: Settings -> API Tokens.
# The plaintext is shown once, at creation time; it starts with "tdl" followed
# by an underscore and a random suffix.
#
# Replace the placeholder below with your own token and keep this file out of
# version control.

TODOLIST_TOKEN=<paste-your-token-here>
