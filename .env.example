# ---------------------------------------------------------------------------
# ToDoList environment template.
#   cp .env.example .env   then edit.  docker compose reads .env automatically.
# Every variable has a working default, so `docker compose up -d --build`
# succeeds even without this file — but you SHOULD set DJANGO_SECRET_KEY.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Comma separated. `*` is convenient for a self-hosted single box.
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_LOG_LEVEL=INFO
# Set to true only when the app is served over HTTPS.
DJANGO_SECURE_SSL=false

# --- Database ---------------------------------------------------------------
POSTGRES_DB=todolist
POSTGRES_USER=todolist
POSTGRES_PASSWORD=change-me-in-production
# Host port mapped to the container's 5432 (5433 avoids a local PostgreSQL).
POSTGRES_HOST_PORT=5433

# --- Web / API ports --------------------------------------------------------
WEB_PORT=8081
API_HOST_PORT=8001

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# --- Application limits -----------------------------------------------------
MAX_WORKSPACES_PER_USER=50
APP_VERSION=1.0.0
IMAGE_TAG=latest

# --- Optional admin bootstrap (created on first boot when both are set) -----
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_USERNAME=admin

# --- Reverse proxy / Cloudflare Tunnel (docs/cloudflare-tunnel.md) ----------
# Public hostname served through the tunnel, e.g. todo.example.com.
# Must also be listed in DJANGO_ALLOWED_HOSTS, and its https:// origin in
# CSRF_TRUSTED_ORIGINS, or the admin will reject logins.
PUBLIC_HOSTNAME=
# Token of a remotely-managed Cloudflare Tunnel (Zero Trust -> Networks ->
# Tunnels -> your tunnel -> Install connector). Only needed for
# `docker compose --profile tunnel up -d cloudflared`.
CLOUDFLARE_TUNNEL_TOKEN=

# --- CORS (development only; production is same-origin) --------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI assistant (optional; docs/ai-assistant.md) -------------------------
# Fernet key protecting the DeepSeek API keys users save in Settings.
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key is derived from DJANGO_SECRET_KEY — convenient locally,
# but rotating DJANGO_SECRET_KEY then makes every stored API key unreadable.
AI_ENCRYPTION_KEY=
# Per-user daily token ceiling for AI calls. 0 disables the limit.
AI_DAILY_TOKEN_BUDGET=50000
# Offered in the Settings model dropdown. Model names churn, so they are config.
AI_MODELS=deepseek-flash,deepseek-chat,deepseek-reasoner
